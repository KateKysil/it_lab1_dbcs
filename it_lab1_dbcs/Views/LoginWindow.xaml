<Window x:Class="it_lab1_dbcs.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="СУБД - Вхід у систему" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F5F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Вітаємо в СУБД" 
                   FontSize="22" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#1D1D1F"/>

        <!-- Вкладки: Вхід / Реєстрація -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E5E5EA">

            <!-- ВКЛАДКА 1: ВХІД -->
            <TabItem Header="Увійти" FontSize="14" FontWeight="SemiBold">
                <StackPanel Margin="15,20,15,15">
                    <TextBlock Text="Логін:" Margin="0,0,0,5" Foreground="#555"/>
                    <TextBox x:Name="txtLoginUsername" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,5" Foreground="#555"/>
                    <PasswordBox x:Name="txtLoginPassword" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                    <Button x:Name="btnLogin" Content="Увійти" Height="35" Margin="0,20,0,0" 
                            Background="#007AFF" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Click="BtnLogin_Click"/>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Реєстрація" FontSize="14" FontWeight="SemiBold">
                <StackPanel Margin="15,15,15,15">
                    <TextBlock Text="Логін:" Margin="0,0,0,5" Foreground="#555"/>
                    <TextBox x:Name="txtRegisterUsername" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                    <TextBlock Text="Пароль:" Margin="0,10,0,5" Foreground="#555"/>
                    <PasswordBox x:Name="txtRegisterPassword" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                    <TextBlock Text="Підтвердження пароля:" Margin="0,10,0,5" Foreground="#555"/>
                    <PasswordBox x:Name="txtRegisterPasswordConfirm" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                    <Button x:Name="btnRegister" Content="Зареєструватися" Height="35" Margin="0,15,0,0" 
                            Background="#34C759" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Click="BtnRegister_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="lblStatus" Grid.Row="2" Margin="0,10,0,0" 
                   TextWrapping="Wrap" HorizontalAlignment="Center" 
                   TextAlignment="Center" FontWeight="Medium"/>
    </Grid>
</Window>