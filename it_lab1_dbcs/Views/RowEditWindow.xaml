<Window x:Class="it_lab1_dbcs.Views.RowEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редагування запису" Height="450" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F5F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblTitle" Grid.Row="0" Text="Додавання запису" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#1D1D1F"/>

        <Border Grid.Row="1" Background="White" CornerRadius="5" BorderBrush="#E5E5EA" BorderThickness="1" Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlFieldsContainer"/>
            </ScrollViewer>
        </Border>

        <!-- 3. Блок відображення помилок валідації -->
        <TextBlock x:Name="lblValidationError" Grid.Row="2" Margin="0,10,0,10" 
                   Foreground="Red" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>

        <!-- 4. Кнопки управління -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
            <Button Content="Скасувати" Width="100" Height="32" Margin="0,0,10,0" 
                    Background="#E5E5EA" Foreground="#1D1D1F" BorderThickness="0" Click="BtnCancel_Click"/>
            <Button Content="Зберегти" Width="120" Height="32" 
                    Background="#007AFF" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>