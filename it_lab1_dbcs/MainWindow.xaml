<Window x:Class="it_lab1_dbcs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Десктопна СУБД" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1" Padding="5">
            <MenuItem Header="Файл">
                <MenuItem Header="Створити нову БД" Click="MenuNewDb_Click"/>
                <MenuItem Header="Відкрити БД з диску..." Click="MenuOpenDb_Click"/>
                <MenuItem Header="Перейменувати БД..." Click="MenuRenameDb_Click"/>
                
                <MenuItem Header="Зберегти БД" Click="MenuSaveDb_Click"/>
                <Separator/>
                <MenuItem Header="Вийти з акаунту" Click="MenuLogout_Click"/>
            </MenuItem>
            <MenuItem Header="Таблиці">
                <MenuItem Header="Додати нову таблицю..." Click="BtnCreateTable_Click"/>
                <MenuItem Header="Видалити поточну таблицю" Click="BtnDeleteTable_Click"/>
                <MenuItem Header="Перейменувати поточну таблицю..." Click="BtnRenameTable_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,0,0,1" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="База даних: " FontWeight="Bold" FontSize="15" Foreground="#1D1D1F"/>
                    <TextBlock x:Name="lblDbName" Text="Не обрано" FontSize="15" Foreground="#007AFF" FontWeight="SemiBold" Margin="0,0,20,0"/>
                    <Button x:Name="btnSaveDb" Content="💾 Зберегти БД" Padding="12,5" 
                    Background="#34C759" Foreground="White" FontWeight="Bold" 
                    BorderThickness="0" Margin="0,0,25,0" Cursor="Hand" Click="MenuSaveDb_Click"/>
                    <TextBlock Text="Поточна таблиця: " FontWeight="Bold" FontSize="15" Foreground="#1D1D1F"/>
                    <TextBlock x:Name="lblTableName" Text="Не обрано" FontSize="15" Foreground="#34C759" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Користувач: " Foreground="#8E8E93"/>
                    <TextBlock x:Name="lblCurrentUser" Text="—" FontWeight="Bold" Foreground="#1D1D1F" Margin="0,0,15,0"/>
                    <Button Content="Вихід" Padding="10,3" Background="#E5E5EA" BorderThickness="0" Click="MenuLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#E5E5EA" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Таблиці БД" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#1D1D1F"/>

                    <ListBox x:Name="lstTables" Grid.Row="1" DisplayMemberPath="Name" 
                             SelectionChanged="LstTables_SelectionChanged" BorderThickness="0"/>

                    <Button Grid.Row="2" Content="+ Створити таблицю" Margin="0,10,0,0" Height="30" 
                            Background="#007AFF" Foreground="White" FontWeight="Bold" 
                            BorderThickness="0" Click="BtnCreateTable_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Додати запис" Height="32" Padding="15,0" Margin="0,0,10,0" 
                            Background="#34C759" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAddRow_Click"/>
                    <Button Content="Редагувати запис" Height="32" Padding="15,0" Margin="0,0,10,0" 
                            Background="#FF9500" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnEditRow_Click"/>
                    <Button Content="Видалити запис" Height="32" Padding="15,0" 
                            Background="#FF3B30" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDeleteRow_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgRecords" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          SelectionMode="Single" IsReadOnly="True" Background="White" 
                          BorderBrush="#E5E5EA" Sorting="DgRecords_Sorting">
                </DataGrid>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="3" Background="White" BorderBrush="#E5E5EA" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Готово" Foreground="#8E8E93"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>